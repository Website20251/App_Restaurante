{
  "name": "restaurante",
  "version": "1.0.0",
  "description": "Sistema de pedidos para restaurante",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.restaurante.pedidos",
    "productName": "Restaurante",
    "files": [
      "main.js",
      "preload.js",
      "ticket-ipc.js",
      "server.js",
      "public/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Restaurante",
      "include": "installer.nsh",
      "language": "3082",
      "artifactName": "Instalar-Restaurante.exe",
      "deleteAppDataOnUninstall": false
    },
    "directories": {
      "output": "instalador"
    }
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
